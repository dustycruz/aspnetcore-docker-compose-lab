# Copy this file to .env and change the password before running "docker compose up".
# .env is ignored by git.
#
# SQL Server requires a strong sa password: at least 8 characters, including three of
# uppercase letters, lowercase letters, digits and symbols. Avoid the characters ; and $
# because the password is also embedded in a connection string and in Compose files.
MSSQL_SA_PASSWORD=Change_Me_Str0ng!Pass

# Host port on which Nginx serves the API (http://localhost:8080).
NGINX_HOST_PORT=8080
